* text=auto
*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.asmdef text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.unity text eol=lf

# Preserve engine-generated empty YAML values and retrieved/OCR source whitespace.
# Keep normal whitespace gates enabled for handwritten production/test code.
*.meta whitespace=-blank-at-eol
Assets/VintageCollector/Scenes/*.unity whitespace=-blank-at-eol
docs/research/evidence/**/*.md whitespace=-blank-at-eol,-blank-at-eof
docs/research/evidence/**/*.txt whitespace=-blank-at-eol,-blank-at-eof

# Preserve exact research/snapshot hashes, including fetched CRLF bytes.
/docs/research/phase5/jungle/** -text whitespace=cr-at-eol
/docs/research/phase5/fossil/** -text whitespace=cr-at-eol
/docs/research/phase5/weight-supplement/** -text whitespace=cr-at-eol
/Authoring/Phase5/ApprovedData/** -text whitespace=cr-at-eol
/Authoring/Phase5/Data/jungle-en-unlimited1999.catalog.json -text whitespace=cr-at-eol
/docs/research/phase5/**/*.html whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
/docs/research/phase5/**/*.txt whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
/docs/research/phase5/**/*.log whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
