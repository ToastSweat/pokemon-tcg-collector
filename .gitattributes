* text=auto
*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.asmdef text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.unity text eol=lf

# Preserve engine-generated empty YAML values and retrieved/OCR source whitespace.
# Keep normal whitespace gates enabled for handwritten production/test code.
*.meta whitespace=-blank-at-eol
docs/research/evidence/**/*.md whitespace=-blank-at-eol,-blank-at-eof
docs/research/evidence/**/*.txt whitespace=-blank-at-eol,-blank-at-eof
