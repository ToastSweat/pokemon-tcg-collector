  {
    "sourceId": 20,
    "key": "wotc-chats",
    "quote": "No, the same odds. Basically a 1 in 3 chance of a foil card in a booster pack.",
    "evidencePath": "docs/research/phase5/jungle/wotc-chats.text.txt",
