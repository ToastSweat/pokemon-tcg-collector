    "verbatimVerified": true
  },
  {
    "sourceId": 20,
    "key": "wotc-chats",
    "quote": "When the cards are printed, the number of foils is 1 in 3 packs. Some people get better odds, some get worse.",
    "evidencePath": "docs/research/phase5/jungle/wotc-chats.text.txt",
